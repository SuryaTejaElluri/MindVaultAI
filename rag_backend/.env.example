# Database & Vector Store (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname?sslmode=require

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
COLLECTION_NAME=rag_documents

# Chunking Configuration
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Authentication & Security
AUTH_SECRET_KEY=your-jwt-secret-key-at-least-32-chars
AUTH_ALGORITHMS=HS256

# Storage Quotas & Limits
MAX_UPLOAD_SIZE_MB=25
USER_STORAGE_QUOTA_MB=50
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Retrieval & OCR Configuration
SIMILARITY_THRESHOLD=0.65
BACKGROUND_THRESHOLD_BYTES=2097152
OCR_ENABLED=false

